// Docs Quality Gate: правила markdownlint для пояснювальної записки (docs/)
{
  "config": {
    "default": true,
    // Довгі рядки природні для україномовної прози й таблиць; контроль довжини вимкнено
    "MD013": false,
    // Дозволено лише HTML-якорі <a id="..."> для перехресних посилань між документами
    "MD033": { "allowed_elements": ["a"] },
    // Однакові назви підзаголовків дозволені лише в різних розділах
    "MD024": { "siblings_only": true },
    // Єдиний стиль заголовків ATX (#, ##) і маркерів списку "-"
    "MD003": { "style": "atx" },
    "MD004": { "style": "dash" },
    // Нумеровані списки: послідовна нумерація 1, 2, 3
    "MD029": { "style": "ordered" },
    // Блоки коду лише огороджені та з мовою (mermaid, yaml, json)
    "MD046": { "style": "fenced" },
    "MD040": true,
    // Курсив і жирний — зірочками
    "MD049": { "style": "asterisk" },
    "MD050": { "style": "asterisk" },
    // Таблиці: послідовний стиль роздільників
    "MD060": false
  },
  "globs": ["docs/**/*.md"],
  "ignores": ["node_modules/**"]
}
